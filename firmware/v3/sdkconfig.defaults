# =============================================================================
# SHE V3 firmware — sdkconfig.defaults (common to all SKUs + profiles)
# =============================================================================
# V3-FIRMWARE §2.4. Overridden by sdkconfig.{dev,prod} and sdkconfig.{r4,r8,r16}.
# =============================================================================

# ---- ESP-IDF version ----
CONFIG_IDF_TARGET="esp32s3"

# ---- FreeRTOS ----
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y

# ---- Wi-Fi ----
CONFIG_ESP_WIFI_STA_RECONNECT_POLICIES=y
CONFIG_ESP_WIFI_STA_DISCONNECT_NW_RECONN_MAX_RETRY=5

# ---- MQTT ----
CONFIG_MQTT_PROTOCOL_5=y
CONFIG_MQTT_TASK_PRIORITY=5
CONFIG_MQTT_BUFFER_SIZE=4096
CONFIG_MQTT_TRANSPORT_SSL=y

# ---- mbedTLS (TLS 1.3, Ed25519, X.509) ----
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_MPI=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_MBEDTLS_ECP_RESTARTABLE=y
CONFIG_MBEDTLS_CMAC_C=y
CONFIG_MBEDTLS_SSL_ALPN=y
# App rollback MUST stay enabled. Without it there is no PENDING_VERIFY state, which means
# ota_handler_is_pending_verify() always returns false and the entire 5-minute health check
# in main.c Step 12 is dead code — along with ota_handler_mark_valid() and
# ota_handler_rollback(). Partitions still alternate A/B, so an update *lands*, but a bad
# image never reverts: the device boots it forever and needs a physical reflash.
#
# With it enabled: an OTA boots as PENDING_VERIFY, main.c runs a 5-minute stability check,
# and either mark_valid() commits it or rollback() reverts to the previous partition.
# This is also what makes the device publish ota/status "success", which is what lets the
# backend move an OTA batch from ROLLING to COMPLETED.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
# TLS 1.3 MUST stay disabled. This is not a preference — it is the fix for a handshake
# failure that cost real debugging time, and it lived only in the generated (gitignored)
# sdkconfig until now, so a fresh clone silently re-broke MQTT.
#
# Symptom when enabled: the TLS handshake dies with
#     esp-tls: ... esp_tls_last_esp_err=0x8004 ... sock_errno=104
#     MBEDTLS_ERR_SSL_INTERNAL_ERROR (-0x6C00)
# because the firmware offers only TLS 1.3 ciphersuites and psa_generate_key() fails.
# EMQX is configured TLS 1.2-only to match (infra/docker-compose.yml).
#
# CONFIG_MBEDTLS_SSL_PROTO_TLS1_3 is not set
# CONFIG_MBEDTLS_TLS1_3_COMPATIBILITY_MODE is not set

# ---- mDNS ----
CONFIG_MDNS_MAX_SERVICES=10
CONFIG_MDNS_TASK_PRIORITY=3
CONFIG_MDNS_TASK_STACK_SIZE=4096

# ---- HTTP Server (local control) ----
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# main/local_ctrl.c calls httpd_ssl_start() (the F1 fix: real TLS for local
# control) and includes esp_https_server.h unconditionally, so the component
# must be enabled or the build dies with
#   fatal error: esp_https_server.h: No such file or directory
# In IDF 5.1.x the component only exports its include dir when this is set:
#   if(CONFIG_ESP_HTTPS_SERVER_ENABLE) set(inc "include") endif()
# Left unset, the header was invisible even though `esp_https_server` was
# already listed in main/CMakeLists.txt REQUIRES.
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
# Implicitly selected by the above; keep it explicit so a Kconfig change
# cannot silently drop TLS server support.
CONFIG_ESP_TLS_SERVER=y

# ---- HTTPS OTA ----
CONFIG_OTA_ALLOW_HTTP=n

# ---- BT/BLE (for Wi-Fi provisioning) ----
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
# protocomm's BLE provisioning path (simple_ble.c) calls the BT 4.2 legacy advertising
# API (esp_ble_gap_config_adv_data / esp_ble_gap_start_advertising). Enabling only the
# BLE 5.0 feature set leaves those symbols undefined at link time.
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_WIFI_PROV_SCHEME_BLE=y

# ---- NVS ----
CONFIG_NVS_ENCRYPTION=y

# ---- Partition table ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# ---- PSRAM (ESP32-S3 only — R8/R16) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80m=y
CONFIG_SPIRAM_BOOT_INIT=y

# ---- Logging ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y
CONFIG_LOG_TIMESTAMP_SOURCE_RTOS=y

# ---- SHE SKU defaults (overridden by sdkconfig.{r4,r8,r16}) ----
# Default = SHE-R8 (volume SKU)
CONFIG_SHE_R8=y
CONFIG_SHE_R4=
CONFIG_SHE_R16=

# ---- Firmware version (baked into binary header) ----
CONFIG_SHE_FIRMWARE_VERSION="3.0.0"
CONFIG_SHE_SECURE_VERSION=1

CONFIG_NVS_SEC_HMAC_EFUSE_KEY_ID=1
