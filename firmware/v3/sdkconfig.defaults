# =============================================================================
# SHE V3 firmware — sdkconfig.defaults (common to all SKUs + profiles)
# =============================================================================
# V3-FIRMWARE §2.4. Overridden by sdkconfig.{dev,prod} and sdkconfig.{r4,r8,r16}.
# =============================================================================

# ---- ESP-IDF version ----
CONFIG_IDF_TARGET="esp32s3"

# ---- FreeRTOS ----
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y

# ---- Wi-Fi ----
CONFIG_ESP_WIFI_STA_RECONNECT_POLICIES=y
CONFIG_ESP_WIFI_STA_DISCONNECT_NW_RECONN_MAX_RETRY=5

# ---- MQTT ----
CONFIG_MQTT_PROTOCOL_5=y
CONFIG_MQTT_TASK_PRIORITY=5
CONFIG_MQTT_BUFFER_SIZE=4096
CONFIG_MQTT_TRANSPORT_SSL=y

# ---- mbedTLS (TLS 1.3, Ed25519, X.509) ----
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_MPI=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_MBEDTLS_ECP_RESTARTABLE=y
CONFIG_MBEDTLS_CMAC_C=y
CONFIG_MBEDTLS_SSL_ALPN=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_TLS1_3_COMPATIBILITY_MODE=y

# ---- mDNS ----
CONFIG_MDNS_MAX_SERVICES=10
CONFIG_MDNS_TASK_PRIORITY=3
CONFIG_MDNS_TASK_STACK_SIZE=4096

# ---- HTTP Server (local control) ----
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# ---- HTTPS OTA ----
CONFIG_OTA_ALLOW_HTTP=n

# ---- NVS ----
CONFIG_NVS_ENCRYPTION=y

# ---- Partition table ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# ---- PSRAM (ESP32-S3 only — R8/R16) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80m=y
CONFIG_SPIRAM_BOOT_INIT=y

# ---- Logging ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y
CONFIG_LOG_TIMESTAMP_SOURCE_RTOS=y

# ---- SHE SKU defaults (overridden by sdkconfig.{r4,r8,r16}) ----
# Default = SHE-R8 (volume SKU)
CONFIG_SHE_R8=y
CONFIG_SHE_R4=
CONFIG_SHE_R16=

# ---- Firmware version (baked into binary header) ----
CONFIG_SHE_FIRMWARE_VERSION="3.0.0"
CONFIG_SHE_SECURE_VERSION=1
