# =============================================================================
# SHE V3 backend — Spring Boot .env.example (local dev)
# =============================================================================
# Copy to backend/.env and adjust. Loaded by `mvn spring-boot:run` via
# spring-boot-maven-plugin's environment support.
#
# Canonical reference: V3-CONFIGURATION.md §2.1, V3-DEVELOPER-SETUP.md §6
# =============================================================================

# ---------- Profile ----------
SPRING_PROFILES_ACTIVE=local

# ---------- Database (V3-CONFIGURATION §2.3) ----------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/she_v3
SPRING_DATASOURCE_USERNAME=she_app
SPRING_DATASOURCE_PASSWORD=ChangeMeLocal
SPRING_DATASOURCE_MIGRATION_USERNAME=she_migrate
SPRING_DATASOURCE_MIGRATION_PASSWORD=ChangeMeLocal
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20

# ---------- Redis (V3-CONFIGURATION §2.4) ----------
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=ChangeMeLocal

# ---------- MQTT (Paho + mTLS, V3-SECURITY-MODEL §4.4) ----------
MQTT_BROKER_URL=ssl://localhost:8883
MQTT_BACKEND_CERT=../infra/ca/out/devices/she-backend.crt
MQTT_BACKEND_KEY=../infra/ca/out/devices/she-backend.key
MQTT_CA_BUNDLE=../infra/ca/ca_bundle.pem
MQTT_SHARED_SUBSCRIPTION_GROUP=she-backend
MQTT_CLIENT_ID_PREFIX=she-backend-local
EMQX_INTERNAL_TOKEN=dev-internal-token-not-for-prod

# ---------- JWT (EdDSA / Ed25519, P1-6) ----------
# Generate with:
#   openssl genpkey -algorithm ed25519 -out infra/ca/keys/jwt_ed25519.pem
#   openssl pkey -in infra/ca/keys/jwt_ed25519.pem -pubout -out infra/ca/keys/jwt_ed25519.pub
JWT_SIGNING_PRIVATE_KEY_PATH=../infra/ca/keys/jwt_ed25519.pem
JWT_SIGNING_KEY_ID=2025q1
# JSON array of {kid, public_key_pem} entries.
# Generate the value with:
#   jq -Rs '{kid:"2025q1", public_key_pem: .}' < infra/ca/keys/jwt_ed25519.pub | jq -c '[.]'
JWT_SIGNING_PUBLIC_KEYS=[{"kid":"2025q1","public_key_pem":"-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAEXAMPLE_REPLACE_WITH_REAL_KEY\n-----END PUBLIC KEY-----\n"}]
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS_USER=2592000
JWT_REFRESH_TOKEN_TTL_SECONDS_TENANT_ADMIN=28800
JWT_REFRESH_TOKEN_TTL_SECONDS_PLATFORM_ADMIN=28800
JWT_REFRESH_TOKEN_TTL_SECONDS_SUPER_ADMIN=14400

# ---------- KEK (AES-256-GCM master key, encrypts TOTP secrets) ----------
KEK=devKekNotForProd000000000000000==

# ---------- MFA ----------
MFA_ISSUER_NAME=SmartHomeEthiopia

# ---------- step-ca (V3-CONFIGURATION §3) ----------
STEP_CA_CLIENT_URL=http://localhost:9002
STEP_CA_CLIENT_PROVISIONER_NAME=she-device-provisioner
STEP_CA_CLIENT_PROVISIONER_PASSWORD_FILE=../infra/ca/step-ca-provisioner-password.txt
CA_INTERMEDIATE_CERT_PATH=../infra/ca/intermediate.crt
CA_BUNDLE_PATH=../infra/ca/ca_bundle.pem
CRL_PUBLISH_BASE_URL=http://localhost:8088/ca

# ---------- Security ----------
BCRYPT_COST=12

# ---------- Actuator ----------
MANAGEMENT_SERVER_PORT=9090

# ---------- CORS (local dev) ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ---------- Logging ----------
SHE_LOG_LEVEL=DEBUG
