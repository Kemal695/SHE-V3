# SHE V3 — root .gitignore

# Secrets / env files (NEVER commit real secrets)
.env
.env.local
.env.*.local
*.env
!**/.env.example
!**/.env.example.local

# Certs / keys
*.key
*.pem
*.p12
*.pfx
*.crt
!**/ca/.gitignore
!**/test/resources/keys/*.pem
!**/test/resources/keys/*.pub

# step-ca data
.step-ca-data/
infra/ca/out/

# Generated NVS provisioning images.
# fctry.bin EMBEDS THE DEVICE PRIVATE KEY — nvs_partition_gen inlines the *contents*
# of the device_cert / device_key files listed in fctry.csv, so the key is inside the
# binary (verify with: strings scripts/nvs-build/fctry.bin | grep PRIVATE). The CSVs
# also carry the device PoP. Regenerate with scripts/build-device-nvs.py — never commit.
scripts/nvs-build/

# OTA signing keys. The public half is already embedded in
# firmware/v3/main/ota_handler.c, so committing this directory adds nothing but risk.
ota-keys/

# Build outputs
backend/target/
**/*.class
**/*.jar

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test coverage
jacoco.exec
**/coverage/

# Docker
docker-compose.override.yml

# Provisioner / CA secrets (plaintext, local only — rotate before any real deploy)
infra/ca/step-ca-provisioner-password.txt
infra/ca/provisioner-key.json

# ESP-IDF build outputs (hundreds of MB) + generated sdkconfig
firmware/*/build/
firmware/*/build-*/
firmware/v3/sdkconfig
firmware/v3/sdkconfig.*
!firmware/v3/sdkconfig.defaults
!firmware/v3/sdkconfig.defaults.*

# Flutter tooling state
.flutter_tool_state
mobile/.flutter_tool_state
mobile/.flutter
.freebuff/

# NOTE: mobile/plugins/ is deliberately NOT ignored.
# It holds flutter_esp_ble_prov, vendored on purpose because upstream 0.1.7 targets AGP 7.4
# with no namespace and no longer builds under Flutter 3.44 (see mobile/pubspec.yaml).
# pubspec.yaml depends on it by path, so ignoring it means `flutter pub get` fails and a
# fresh clone cannot build the app at all.

# Gradle build output
mobile/android/build/
mobile/android/app/build/
mobile/build/

# Local scratch / one-off artifacts
_backup_*.dump
_hw.txt
scripts/_screen.png
backend/test*.sh
backend/final-5.sh

# Python
__pycache__/
*.py[cod]

# Assistant workspace
.workbuddy-ai/
