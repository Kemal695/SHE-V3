# =============================================================================
# SHE V3 — Local development environment variables
# =============================================================================
# Copy this file to `.env` (in same directory) and adjust values as needed.
# NEVER commit `.env` — only `.env.example` is committed.
#
# Canonical reference: V3-CONFIGURATION.md §2.1-2.5, V3-DEVELOPER-SETUP.md §6
# Production values are provisioned via systemd EnvironmentFile= and live in
# /etc/she/env/{spring-boot,emqx,postgres,redis,minio,nginx}.env (mode 0400).
# =============================================================================

# ---------- Docker compose shared ----------
COMPOSE_PROJECT_NAME=she-v3

# ---------- PostgreSQL 16 (V3-CONFIGURATION §2.3) ----------
POSTGRES_DB=she_v3
POSTGRES_USER=she_app
# IMPORTANT: she_app is NOT a superuser and does NOT have BYPASSRLS (P0-5).
# The Postgres init script creates she_app via the superuser and grants
# SELECT/INSERT/UPDATE/DELETE on the public schema.
POSTGRES_PASSWORD=ChangeMeLocal
POSTGRES_SUPERUSER_PASSWORD=ChangeMeLocalSuper

# ---------- Redis 7 (V3-CONFIGURATION §2.4) ----------
REDIS_PASSWORD=ChangeMeLocal

# ---------- EMQX 5.x (V3-CONFIGURATION §2.2) ----------
# Cookie must be IDENTICAL on all 3 nodes — Ekka Mnesia mesh auth
EMQX_NODE__COOKIE=she_cluster_cookie_change_me_in_prod
EMQX_DASHBOARD__DEFAULT_USERNAME=admin
EMQX_DASHBOARD__DEFAULT_PASSWORD=ChangeMeLocal

# ---------- MinIO (V3-CONFIGURATION §2.5) ----------
MINIO_ROOT_USER=she
MINIO_ROOT_PASSWORD=ChangeMeLocal

# ---------- step-ca (V3-CONFIGURATION §3) ----------
# Provisioner password is read from infra/ca/step-ca-provisioner-password.txt
# (gitignored). Generate with: openssl rand -base64 24 > infra/ca/step-ca-provisioner-password.txt
STEP_CA_URL=http://localhost:9002
STEP_CA_PROVISIONER_NAME=she-device-provisioner
# Root CA fingerprint — printed by bootstrap-ca.sh on first init.
# Fill this in AFTER the first `docker compose up step-ca` run.
STEP_CA_FINGERPRINT=

# ---------- Spring Boot backend (V3-CONFIGURATION §2.1) ----------
# These are read by backend/.env (which is loaded by spring-boot:run).
# Copy this section to backend/.env

# --- Core ---
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=9090
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -XX:+UseG1GC

# --- Database ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/she_v3
SPRING_DATASOURCE_USERNAME=she_app
SPRING_DATASOURCE_PASSWORD=ChangeMeLocal
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true

# --- Redis ---
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=ChangeMeLocal

# --- MQTT (Paho, mTLS) ---
# In local dev, MQTT is at localhost:8883 (mapped from emqx-1).
# In prod, multiple broker URLs can be specified comma-separated.
MQTT_BROKER_URL=ssl://localhost:8883
MQTT_BACKEND_CERT=/etc/she/certs/she-backend.crt
MQTT_BACKEND_KEY=/etc/she/certs/she-backend.key
MQTT_CA_BUNDLE=/etc/she/ca/ca_bundle.pem
MQTT_SHARED_SUBSCRIPTION_GROUP=she-backend
MQTT_CLIENT_ID_PREFIX=she-backend

# --- JWT (EdDSA / Ed25519, P1-6) ---
# Generate with:
#   openssl genpkey -algorithm ed25519 -out infra/ca/keys/jwt_ed25519.pem
#   openssl pkey -in infra/ca/keys/jwt_ed25519.pem -pubout -out infra/ca/keys/jwt_ed25519.pub
#   jq -Rs '{kid:"2025q1", public_key_pem: .}' < infra/ca/keys/jwt_ed25519.pub
JWT_SIGNING_PRIVATE_KEY_PATH=../infra/ca/keys/jwt_ed25519.pem
# JSON array of {kid, public_key_pem} entries. Spring Boot accepts ALL listed
# keys during rotation window — old tokens validate against previous kid
# until they expire. NO forced re-login during rotation (P1-6).
JWT_SIGNING_PUBLIC_KEYS=[{"kid":"2025q1","public_key_pem":"REPLACE_WITH_ACTUAL_PEM"}]
JWT_SIGNING_KEY_ID=2025q1
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS_USER=2592000
JWT_REFRESH_TOKEN_TTL_SECONDS_TENANT_ADMIN=28800
JWT_REFRESH_TOKEN_TTL_SECONDS_PLATFORM_ADMIN=28800
JWT_REFRESH_TOKEN_TTL_SECONDS_SUPER_ADMIN=14400

# --- KEK (AES-256-GCM, encrypts TOTP secrets) ---
# Generate with: openssl rand -base64 32
KEK=devKekNotForProd000000000000000==

# --- MFA ---
MFA_ISSUER_NAME=SmartHomeEthiopia

# --- step-ca client (Spring Boot calls step-ca REST API to sign device CSRs) ---
# Spring Boot NEVER holds the CA private key (P0-2, P1-24).
STEP_CA_CLIENT_URL=http://step-ca:9000
STEP_CA_CLIENT_PROVISIONER_NAME=she-device-provisioner
STEP_CA_CLIENT_PROVISIONER_PASSWORD_FILE=../infra/ca/step-ca-provisioner-password.txt
CA_INTERMEDIATE_CERT_PATH=../infra/ca/intermediate.crt
CA_BUNDLE_PATH=../infra/ca/ca_bundle.pem
CRL_PUBLISH_BASE_URL=http://localhost:8088/ca

# --- Security: password hashing ---
# BCrypt cost 12 per V3-DATABASE-DESIGN §4.2
BCRYPT_COST=12

# --- HTTP request ID header (V3-ERROR-CODES §1) ---
REQUEST_ID_HEADER=X-Request-Id

# --- CORS (local dev only — disabled in prod via Cloudflare + Nginx) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
